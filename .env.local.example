# Port chạy ứng dụng (Mặc định: 4173)
PORT=4173

# Khóa bí mật cho Session JWT Token (Nên đổi chuỗi ngẫu nhiên khi chạy production)
JWT_SECRET=supersecretjwtkeyforotsupporttool2026

# Mật khẩu mặc định khởi tạo ban đầu cho thành viên (Mặc định: Amaze@2026)
DEFAULT_PASSWORD=Amaze@2026

# Cấu hình Google Chat Webhook để gửi thông báo ca trực
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/.../messages?key=...&token=...

# Token bảo mật để kích hoạt API nhắc lịch tự động từ GitHub Actions Cron
CRON_TOKEN=mot_chuoi_token_bao_mat_ngau_nhien

# Cấu hình múi giờ (Việt Nam)
TZ=Asia/Ho_Chi_Minh
